<?xml version="1.0" encoding="iso-8859-1"?>

<!--
	Repo-local copy of the Crimsonland Android rip's terrains/terrains.xml,
	consumed by scripts/prep-terrains.py (bitmap refs still resolve against
	the rip). Verbatim except: CHAPTER_2 layers the game's original
	scorched-earth bg.png under the desert, and CHAPTER_4's tank-track
	FootPrints had a duplicated bm1 attribute (invalid XML) fixed to bm2,
	and the dashed divider in the NOTES comment below became underscores
	("double-hyphen" is illegal inside XML comments).
-->

<!--

NOTES:
	Each array node does a certain draw operation depending on the 'action' parameter.
	If none is defined, default action "DrawSplashes" is used.
	
	action						parameters							desc
	_________________________________________________________________________________________________________
	"Clear"						color_r color_g color_b				Clears the whole screen with given color
	"DrawTiled"					bm tile_scale tile_spacing alpha	Fills the whole terrain tiled with given bitmap at random angles
	"DrawSplashes"				bm num_splashes alpha				Draws given bitmap at random positions with given parameters
	"DrawSingle"				bm x y angle_degrees scale alpha	Draws a single bitmap with given parameters.

		
-->



